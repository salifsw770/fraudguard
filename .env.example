# Copier ce fichier en .env puis remplacer les valeurs factices.
# Le fichier .env n'est JAMAIS commité.

# --- Base de données PostgreSQL ---
POSTGRES_DB=fraudguard
POSTGRES_USER=fraudguard
POSTGRES_PASSWORD=changeme

# --- Sécurité (JWT) ---
# Générer une valeur longue et aléatoire, par exemple : openssl rand -base64 64
JWT_SECRET=changeme-valeur-longue-et-aleatoire
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Comptes de démo créés au démarrage ---
DEMO_ADMIN_EMAIL=admin@fraudguard.local
DEMO_ADMIN_PASSWORD=changeme
DEMO_AGENT_EMAIL=agent@fraudguard.local
DEMO_AGENT_PASSWORD=changeme

# --- Clé d'API du simulateur de paiement (POST /api/transactions) ---
SIMULATOR_API_KEY=changeme

# --- Service IA (réseau Docker interne uniquement) ---
ML_SERVICE_URL=http://ml-service:8000

# --- Explication des scores : template | ollama | api ---
EXPLICATION_MODE=template
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
LLM_API_URL=
LLM_API_KEY=

# --- Frontend (utilisé pour la configuration CORS) ---
FRONTEND_URL=http://localhost:4200
